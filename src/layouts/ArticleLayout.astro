---
import BaseLayout from './BaseLayout.astro';
import Cover from '../components/Cover.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { formatDate, readingTime, type Post, type Sport } from '../lib/posts';

interface Props {
  post: Post;
  sport?: Sport;
  related: Post[];
  sports: Map<string, Sport>;
}
const { post, sport, related, sports } = Astro.props;
const { title, description, date, updated, cover, coverAlt, tags } = post.data;
---

<BaseLayout title={title} description={description} image={cover} type="article" publishedTime={date} accent={sport?.data.color}>
  <div class="progress" aria-hidden="true"></div>

  <article>
    <header class="ahead">
      <div class="ahead__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="ahead__meta">
          {sport && <a class="chip" href={`/sports/${sport.id}/`}>{sport.data.emoji} {sport.data.name}</a>}
          <span class="muted">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            · {readingTime(post.body)} de lecture
            {updated && <> · mis à jour le <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
          </span>
        </div>
        <h1 class="display ahead__title">{title}</h1>
        <p class="ahead__lead">{description}</p>
      </div>
    </header>

    <div class="container">
      <Cover class="acover" src={cover} alt={coverAlt} sport={sport} eager transitionName={`cover-${post.id}`} />
    </div>

    <div class="container abody">
      <div class="prose">
        <slot />
      </div>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Mots-clés">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section related">
      <div class="container">
        <div class="section-head">
          <h2 class="display h-md">À lire <span class="outline">aussi</span></h2>
          {sport && <a class="link-arrow" href={`/sports/${sport.id}/`}>Tout {sport.data.name} →</a>}
        </div>
        <ul class="related__grid">
          {related.map((p, i) => <li><ArticleCard post={p} sport={sports.get(p.data.sport)} index={i} /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .progress {
    position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 80;
    background: var(--sport); transform-origin: left; transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { transform: scaleX(1); } }
  }

  .ahead { position: relative; padding: clamp(2.5rem, 7vw, 5.5rem) 0 2.5rem; isolation: isolate; }
  .ahead__glow {
    position: absolute; inset: -30% 0 auto; height: 120%; z-index: -1;
    background: radial-gradient(50% 60% at 50% 0%, color-mix(in srgb, var(--sport) 25%, transparent), transparent 70%);
  }
  .ahead .container { max-width: 62rem; }
  .ahead__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .ahead__title { font-size: clamp(2.8rem, 8.5vw, 6.5rem); margin: 0; }
  .ahead__lead { font-size: clamp(1.15rem, 2.2vw, 1.45rem); color: #ddd8e8; max-width: 48ch; margin: 1.5rem 0 0; }

  .container :global(.acover) {
    aspect-ratio: 16 / 8; border-radius: var(--radius); border: 1px solid var(--line);
    max-width: 72rem; margin: 0 auto;
  }
  @media (max-width: 640px) { .container :global(.acover) { aspect-ratio: 4 / 3; } }

  .abody { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: 3rem; }
  .abody .prose { margin: 0 auto; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: var(--prose); margin: 2.5rem auto 0; padding: 0; }
  .tags li { padding: 0.35rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.85rem; color: var(--muted); }

  .related { background: var(--bg-2); border-top: 1px solid var(--line); }
  .related__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); }
</style>
