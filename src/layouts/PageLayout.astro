---
// Mise en page des pages éditables depuis l'admin (À propos, Services…)
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, eyebrow, intro, image, imageAlt } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <section class="section page-hero">
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {intro && <p class="lead muted">{intro}</p>}
    </div>
  </section>
  <section class="section page-body">
    <div class:list={['container', 'page-grid', { 'has-image': !!image }]}>
      {image && <img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" width="800" height="1000" />}
      <div class="prose">
        <slot />
      </div>
    </div>
    <slot name="after" />
  </section>
</BaseLayout>

<style>
  .page-hero { padding-bottom: 0; }
  .lead { font-size: 1.2rem; max-width: 40rem; }
  .page-body { padding-top: 2rem; }
  .page-grid { display: grid; gap: 2.5rem; }
  .page-grid img { border-radius: var(--radius); width: 100%; object-fit: cover; aspect-ratio: 4 / 5; }
  @media (min-width: 900px) {
    .page-grid.has-image { grid-template-columns: 2fr 3fr; align-items: start; }
  }
</style>
