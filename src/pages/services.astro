---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const page = await getEntry('pages', 'services');
if (!page) throw new Error('src/content/pages/services.md est introuvable');
const { Content } = await render(page);
const { services } = page.data;
---

<PageLayout {...page.data}>
  {services.length > 0 && (
    <ul class="services">
      {services.map((s) => (
        <li class="service">
          <h2>{s.title}</h2>
          <p class="muted">{s.description}</p>
        </li>
      ))}
    </ul>
  )}
  <Content />
  <div slot="after" class="container cta">
    <h2>Un projet en tête ?</h2>
    <a class="btn" href="/contact/">Demander un devis</a>
  </div>
</PageLayout>

<style>
  .services {
    list-style: none; padding: 0 !important; margin: 0 0 3rem !important;
    display: grid; gap: 1rem;
  }
  .service {
    background: var(--c-surface); border: 1px solid var(--c-border);
    border-radius: var(--radius); padding: 1.5rem; margin: 0 !important;
  }
  .service h2 { font-size: 1.3rem; margin: 0 0 0.4rem; }
  .service p { margin: 0; }
  .cta {
    margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--c-border);
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  .cta h2 { margin: 0; }
</style>
