---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SportTile from '../components/SportTile.astro';
import Ticker from '../components/Ticker.astro';
import { getPublishedPosts, getSports, displayTitle } from '../lib/posts';

const page = await getEntry('pages', 'accueil');
if (!page) throw new Error('src/content/pages/accueil.md est introuvable');
const { Content } = await render(page);
const { title, description, eyebrow, intro, cta, image } = page.data;

const posts = await getPublishedPosts();
const sports = await getSports();
const sportMap = new Map(sports.map((s) => [s.id, s]));

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const others = posts.filter((p) => p !== featured).slice(0, 4);
const countBySport = (id: string) => posts.filter((p) => p.data.sport === id).length;

const tickerItems = posts.slice(0, 8).map((p) => ({
  label: p.data.title,
  href: `/blog/${p.id}/`,
  tag: sportMap.get(p.data.sport)?.data.name,
}));
---

<BaseLayout description={description} image={image ?? featured?.data.cover}>
  <!-- ============ EN-TÊTE ============ -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="corners hero__corners" aria-hidden="true"></span>
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      <h1 class="display hero__title" set:html={displayTitle(title)} />
      {intro && <p class="hero__intro">{intro}</p>}
      <div class="hero__extra"><Content /></div>
      <div class="hero__actions">
        {cta && <a class="btn" href={cta.href}>{cta.label} <span class="arrow" aria-hidden="true">→</span></a>}
        <a class="btn btn--ghost" href="/sports/">Par sport</a>
      </div>
    </div>
    <ul class="sport-chips container" aria-label="Rubriques">
      {sports.map((s) => (
        <li><a class="chip" style={`--sport:${s.data.color}`} href={`/sports/${s.id}/`}>{s.data.emoji} {s.data.name}</a></li>
      ))}
    </ul>
  </section>

  {tickerItems.length > 0 && <Ticker items={tickerItems} />}

  <!-- ============ À LA UNE ============ -->
  {featured && (
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <div>
            <p class="kicker">À la une</p>
            <h2 class="display h-md">Dernières actus</h2>
          </div>
          <a class="link-arrow" href="/blog/">Toute l'actu →</a>
        </div>
        <div class="bento">
          <div class="bento__main">
            <ArticleCard post={featured} sport={sportMap.get(featured.data.sport)} variant="feature" headingLevel="h3" />
          </div>
          {others.map((p, i) => (
            <div><ArticleCard post={p} sport={sportMap.get(p.data.sport)} index={i + 1} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ SPORTS ============ -->
  <section class="section sports">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Rubriques</p>
          <h2 class="display h-md">Par sport</h2>
        </div>
        <a class="link-arrow" href="/sports/">Tous les sports →</a>
      </div>
      <div class="tiles">
        {sports.map((s, i) => <SportTile sport={s} count={countBySport(s.id)} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête ---------- */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    padding: clamp(2.5rem, 7vw, 5rem) 0 2.5rem;
    background: radial-gradient(60% 90% at 85% 0%, color-mix(in srgb, var(--violet) 30%, transparent), transparent 70%);
  }
  .hero__inner { position: relative; container-type: inline-size; padding-block: clamp(1.5rem, 4vw, 3rem); }
  .hero__inner > :not(.corners) { position: relative; z-index: 1; }
  .hero__corners { --cs: clamp(2.5rem, 8cqi, 5.5rem); --cw: clamp(4px, 0.6cqi, 7px); --ci: 0 0.25rem; z-index: 0; }
  .hero__title { margin: 0; font-size: clamp(3rem, 9vw, 7.5rem); max-width: 14ch; }
  .hero__intro { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: #ddd8e8; max-width: 52ch; white-space: pre-line; margin: 1.5rem 0 0; }
  .hero__extra :global(p) { color: var(--muted); max-width: 52ch; margin: 1rem 0 0; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .sport-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }

  /* ---------- À la une ---------- */
  .bento { display: grid; gap: 1.25rem; }
  @media (min-width: 700px) { .bento { grid-template-columns: repeat(2, 1fr); } .bento__main { grid-column: 1 / -1; } }
  @media (min-width: 1100px) {
    .bento { grid-template-columns: repeat(4, 1fr); }
    .bento__main { grid-column: span 2; grid-row: span 2; }
    .bento__main :global(.card--feature) { min-height: 100%; }
  }

  /* ---------- Sports ---------- */
  .sports { background: var(--bg-2); border-block: 1px solid var(--line); }
  .tiles { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
</style>
