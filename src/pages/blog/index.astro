---
// Page 1 du blog. Les pages suivantes sont dans blog/page/[page].astro
import BlogListing from '../../components/BlogListing.astro';
import { getPublishedPosts } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../consts';

const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

const page = {
  data: posts.slice(0, POSTS_PER_PAGE),
  start: 0,
  end: Math.min(POSTS_PER_PAGE, posts.length) - 1,
  size: POSTS_PER_PAGE,
  total: posts.length,
  currentPage: 1,
  lastPage,
  url: {
    current: '/blog/',
    prev: undefined,
    next: lastPage > 1 ? '/blog/page/2/' : undefined,
    first: undefined,
    last: lastPage > 1 ? `/blog/page/${lastPage}/` : undefined,
  },
};
---

<BlogListing page={page} />
