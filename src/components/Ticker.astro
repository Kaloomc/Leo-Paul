---
// Bandeau « dernières infos » façon chaîne d'actu
interface Props { items: { label: string; href?: string; tag?: string }[] }
const { items } = Astro.props;
---

<div class="ticker" role="region" aria-label="Dernières infos">
  <p class="ticker__label"><span class="ticker__live" aria-hidden="true"></span>Dernières infos</p>
  <div class="ticker__viewport">
    <div class="ticker__track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((it) => (
            <li>
              {it.tag && <span class="ticker__tag">{it.tag}</span>}
              {it.href ? <a href={it.href} tabindex={copy === 1 ? -1 : undefined}>{it.label}</a> : it.label}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker {
    display: flex; align-items: stretch; overflow: hidden;
    background: var(--surface); border-block: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .ticker__label {
    flex: none; display: flex; align-items: center; gap: 0.55rem; margin: 0; padding: 0 1.1rem;
    background: var(--accent); color: var(--accent-ink);
    font-weight: 800; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap;
  }
  .ticker__live { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  .ticker__viewport { overflow: hidden; flex: 1; mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent); }
  .ticker__track { display: flex; width: max-content; animation: scroll 60s linear infinite; }
  .ticker:hover .ticker__track, .ticker:focus-within .ticker__track { animation-play-state: paused; }
  ul { display: flex; list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.5rem; white-space: nowrap; border-right: 1px solid var(--line); }
  .ticker__tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  li a { text-decoration: none; font-weight: 600; }
  li a:hover { color: var(--accent); }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track, .ticker__live { animation: none; }
    .ticker__viewport { overflow-x: auto; }
  }
  @media (max-width: 520px) { .ticker__label { padding: 0 0.8rem; font-size: 0.68rem; } }
</style>
