---
// Image de couverture, ou visuel généré aux couleurs du sport si pas d'image.
import type { Sport } from '../lib/posts';

interface Props {
  src?: string;
  alt?: string;
  sport?: Sport;
  eager?: boolean;
  transitionName?: string;
  class?: string;
}
const { src, alt = '', sport, eager = false, transitionName, class: cls } = Astro.props;
const color = sport?.data.color ?? 'var(--accent)';
// les coins prennent la couleur menthe de la charte, quel que soit le sport
const emoji = sport?.data.emoji ?? '🏅';
const name = sport?.data.name ?? 'Actu';
---

<div class:list={['cover', cls]} style={`--sport:${color}`} transition:name={transitionName}>
  {src ? (
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      width="1200"
      height="750"
    />
  ) : (
    <div class="cover__art" aria-hidden="true">
      <span class="cover__brand">SportFlash</span>
      <span class="cover__emoji">{emoji}</span>
      <span class="cover__sport">{name}</span>
    </div>
  )}
  <span class="corners" aria-hidden="true"></span>
</div>

<style>
  .cover { position: relative; overflow: hidden; background: var(--surface); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  /* voile sombre façon visuels Insta */
  .cover:has(img)::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgb(9 7 13 / 0.55), transparent 55%), color-mix(in srgb, var(--violet) 12%, transparent);
  }
  .cover__art {
    position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden;
    background:
      radial-gradient(90% 80% at 50% 45%, color-mix(in srgb, var(--violet) 55%, transparent), transparent 70%),
      radial-gradient(70% 60% at 85% 10%, color-mix(in srgb, var(--sport) 35%, transparent), transparent 70%),
      radial-gradient(60% 60% at 10% 100%, rgb(0 0 0 / 0.6), transparent 70%),
      #120d1b;
  }
  .cover__brand {
    position: absolute; top: clamp(0.9rem, 6cqi, 2.6rem); left: clamp(0.9rem, 6cqi, 2.6rem);
    font-family: var(--font-display); font-weight: 800; font-stretch: 62%;
    font-size: clamp(0.9rem, 5cqi, 1.8rem); line-height: 1; color: var(--accent);
  }
  .cover__emoji {
    font-size: clamp(2.5rem, 14cqi, 6rem); line-height: 1;
    filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.45)) saturate(0.85);
    transition: transform 0.9s var(--ease);
  }
  .cover__sport {
    position: absolute; bottom: clamp(0.9rem, 6cqi, 2.6rem); right: clamp(0.9rem, 6cqi, 2.6rem);
    font-size: clamp(0.65rem, 2.6cqi, 0.85rem); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }
  .cover { container-type: inline-size; }
</style>
