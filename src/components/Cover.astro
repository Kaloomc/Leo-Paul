---
// Image de couverture, ou visuel généré aux couleurs du sport si pas d'image.
import type { Sport } from '../lib/posts';

interface Props {
  src?: string;
  alt?: string;
  sport?: Sport;
  eager?: boolean;
  transitionName?: string;
  class?: string;
}
const { src, alt = '', sport, eager = false, transitionName, class: cls } = Astro.props;
const color = sport?.data.color ?? 'var(--accent)';
const emoji = sport?.data.emoji ?? '🏅';
const name = sport?.data.name ?? 'Sport';
---

<div class:list={['cover', cls]} style={`--sport:${color}`} transition:name={transitionName}>
  {src ? (
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      width="1200"
      height="750"
    />
  ) : (
    <div class="cover__art" aria-hidden="true">
      <span class="cover__word">{name} {name} {name}</span>
      <span class="cover__emoji">{emoji}</span>
    </div>
  )}
</div>

<style>
  .cover { position: relative; overflow: hidden; background: var(--surface); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .cover__art {
    position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, color-mix(in srgb, var(--sport) 70%, transparent), transparent 60%),
      radial-gradient(80% 80% at 0% 100%, color-mix(in srgb, var(--sport) 35%, transparent), transparent 70%),
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 14px),
      #121214;
  }
  .cover__word {
    position: absolute; left: -5%; bottom: -0.12em; white-space: nowrap;
    font-family: var(--font-display); font-weight: 900; font-stretch: 62%; text-transform: uppercase;
    font-size: clamp(5rem, 22cqi, 14rem); line-height: 0.8;
    color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.22);
  }
  .cover__emoji {
    font-size: clamp(3rem, 18cqi, 8rem); transform: rotate(-12deg);
    filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.45));
    transition: transform 0.9s var(--ease);
  }
  .cover { container-type: inline-size; }
</style>
