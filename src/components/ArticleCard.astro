---
import type { Post, Sport } from '../lib/posts';
import { formatDate, readingTime } from '../lib/posts';
import Cover from './Cover.astro';

interface Props {
  post: Post;
  sport?: Sport;
  variant?: 'default' | 'feature';
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { post, sport, variant = 'default', index = 0, headingLevel = 'h3' } = Astro.props;
const { title, description, date, cover, coverAlt } = post.data;
const Heading = headingLevel;
const color = sport?.data.color;
---

<article
  class:list={['card', `card--${variant}`]}
  style={`--i:${index % 6};${color ? `--sport:${color}` : ''}`}
  data-reveal
>
  <Cover
    class="card__cover"
    src={cover}
    alt={coverAlt}
    sport={sport}
    eager={variant === 'feature'}
    transitionName={`cover-${post.id}`}
  />
  <div class="card__body">
    <div class="card__meta">
      {sport && <a class="chip" href={`/sports/${sport.id}/`}>{sport.data.emoji} {sport.data.name}</a>}
      <span class="muted"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)}</span>
    </div>
    <Heading class:list={['card__title', variant === 'feature' ? 'display h-lg' : 'display h-sm']}>
      <a href={`/blog/${post.id}/`}>{title}</a>
    </Heading>
    <p class="card__desc muted">{description}</p>
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; transition: border-color 0.4s var(--ease), transform 0.5s var(--ease);
  }
  .card::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; border-radius: inherit;
    background: radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--sport) 18%, transparent), transparent);
    opacity: 0; transition: opacity 0.5s var(--ease);
  }
  .card:hover { border-color: color-mix(in srgb, var(--sport) 55%, transparent); transform: translateY(-4px); }
  .card:hover::before { opacity: 1; }
  .card:hover :global(.cover img) { transform: scale(1.06); }
  .card:hover :global(.cover__emoji) { transform: scale(1.06); }
  .card:hover :global(.corners)::before { transform: translate(6px, -6px); }
  .card:hover :global(.corners)::after { transform: translate(-6px, 6px); }
  .card:focus-within { outline: 3px solid var(--sport); outline-offset: 3px; }

  .card :global(.card__cover) { aspect-ratio: 16 / 10; }
  .card__body { position: relative; display: flex; flex-direction: column; gap: 0.75rem; padding: 1.4rem 1.4rem 1.5rem; flex: 1; }
  .card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; font-size: 0.82rem; }
  .card__title { margin: 0; }
  .card__title a { text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card__title a:focus-visible { outline: none; }
  .card:hover .card__title a { color: var(--sport); }
  .card__desc { margin: 0; font-size: 0.97rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* Variante « à la une » : image en grand, texte par-dessus */
  .card--feature { min-height: 30rem; justify-content: flex-end; }
  .card--feature :global(.card__cover) { position: absolute; inset: 0; aspect-ratio: auto; }
  .card--feature .card__body {
    flex: 0; padding: clamp(1.4rem, 4vw, 2.75rem);
    background: linear-gradient(to top, rgb(9 7 13 / 0.96) 20%, rgb(9 7 13 / 0.6) 65%, transparent);
  }
  .card--feature :global(.cover__art) { place-items: center; padding-bottom: 30%; }
  .card--feature :global(.cover__sport) { display: none; }
  .card--feature :global(.corners) { --cs: clamp(3rem, 12cqi, 8rem); }
  /* le coin bas-gauche passerait sous le texte : on garde celui du haut */
  .card--feature :global(.corners)::after { display: none; }
  .card--feature .card__title { max-width: 18ch; }
  .card--feature .card__desc { color: #ddd8e8; max-width: 52ch; font-size: 1.05rem; }
  .card--feature .card__meta .muted { color: #ddd8e8; }

  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transform: none; }
  }
</style>
