---
import { SITE_TITLE, NAV } from '../consts';
import SocialLinks from './SocialLinks.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="hdr" transition:persist="header">
  <div class="container hdr__inner">
    <a class="logo" href="/" aria-label={`${SITE_TITLE} — accueil`}>
      <img class="logo__mark" src="/logo.svg" alt="" width="36" height="37" />
      <span class="logo__name">{SITE_TITLE}</span>
    </a>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul>
        {NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="nav__num" aria-hidden="true">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <SocialLinks class="nav__socials" />
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="nav">
      <span class="sr-only">Menu</span>
      <span class="burger__lines" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('.hdr');
    const btn = document.querySelector<HTMLButtonElement>('.burger');
    const nav = document.getElementById('nav');
    if (!header || !btn || !nav) return;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.onclick = () => setOpen(btn.getAttribute('aria-expanded') !== 'true');
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

    // Lien actif (le header est conservé entre les pages)
    const update = () => {
      setOpen(false);
      nav.querySelectorAll('a').forEach((a) => {
        const active = location.pathname.startsWith(a.getAttribute('href') || '#');
        if (active) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    };
    document.addEventListener('astro:after-swap', update);

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  initHeader();
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 60;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .hdr.is-scrolled {
    background: rgb(9 7 13 / 0.8); backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--line);
  }
  /* backdrop-filter crée un bloc conteneur : le menu plein écran serait coupé */
  .hdr.is-open { backdrop-filter: none; background: transparent; }
  .hdr__inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: 1rem; }

  .logo { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; position: relative; z-index: 2; }
  .logo__name {
    font-family: var(--font-display); font-weight: 800; font-stretch: 62%; font-size: 1.9rem; line-height: 1;
    color: var(--accent); transition: letter-spacing 0.4s var(--ease);
  }
  .logo:hover .logo__name { letter-spacing: 0.03em; }
  .logo__mark { width: 2.25rem; height: auto; transition: transform 0.5s var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-90deg); }
  @media (prefers-reduced-motion: reduce) { .logo__mark { transition: none; } }

  .nav { display: flex; align-items: center; gap: 1rem; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; }
  .nav a {
    position: relative; display: inline-flex; align-items: baseline; gap: 0.35rem;
    padding: 0.55rem 0.9rem; text-decoration: none; font-weight: 600; font-size: 0.95rem;
  }
  .nav__num { font-size: 0.65rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .nav a::after {
    content: ''; position: absolute; left: 0.9rem; right: 0.9rem; bottom: 0.3rem; height: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease);
  }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .nav a[aria-current='page'] { color: var(--accent); }

  .burger {
    display: none; position: relative; z-index: 2; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid var(--line-strong); background: transparent; color: var(--text); cursor: pointer;
  }
  .burger__lines, .burger__lines::before, .burger__lines::after {
    display: block; width: 18px; height: 2px; background: currentColor; margin: 0 auto; position: relative;
    transition: transform 0.35s var(--ease), background 0.2s;
  }
  .burger__lines::before, .burger__lines::after { content: ''; position: absolute; left: 0; }
  .burger__lines::before { top: -6px; }
  .burger__lines::after { top: 6px; }
  .is-open .burger__lines { background: transparent; }
  .is-open .burger__lines::before { transform: translateY(6px) rotate(45deg); }
  .is-open .burger__lines::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 799px) {
    .burger { display: block; }
    .nav {
      position: fixed; inset: 0; z-index: 1; background: var(--bg);
      flex-direction: column; align-items: flex-start; justify-content: center; gap: 2.5rem; padding: 6rem 1.5rem 2rem;
      clip-path: circle(0 at calc(100% - 2.6rem) 2.25rem);
      transition: clip-path 0.6s var(--ease); visibility: hidden;
    }
    .is-open .nav { clip-path: circle(150% at calc(100% - 2.6rem) 2.25rem); visibility: visible; }
    .nav ul { flex-direction: column; gap: 0.25rem; width: 100%; }
    .nav a {
      font-family: var(--font-display); font-weight: 800; font-stretch: 62%;
      font-size: clamp(3.4rem, 17vw, 5.5rem); line-height: 1; padding: 0.3rem 0; gap: 1rem;
    }
    .nav__num { font-family: var(--font-body); font-size: 0.85rem; font-stretch: 100%; color: var(--accent); }
    .nav :global(.nav__socials) { opacity: 0; transition: opacity 0.5s var(--ease); }
    .is-open .nav :global(.nav__socials) { opacity: 1; transition-delay: 0.45s; }
    .nav a::after { display: none; }
    .nav li { opacity: 0; transform: translateY(20px); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); }
    .is-open .nav li { opacity: 1; transform: none; transition-delay: calc(0.15s + var(--i) * 60ms); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav, .nav li { transition: none !important; }
  }
</style>
