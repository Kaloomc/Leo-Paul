---
import type { Sport } from '../lib/posts';
interface Props { sport: Sport; count: number; index: number }
const { sport, count, index } = Astro.props;
const { name, emoji, color, tagline } = sport.data;
---

<a class="tile" href={`/sports/${sport.id}/`} style={`--sport:${color};--i:${index}`} data-reveal>
  <span class="tile__num">{String(index + 1).padStart(2, '0')}</span>
  <span class="tile__emoji" aria-hidden="true">{emoji}</span>
  <span class="tile__name display">{name}</span>
  <span class="tile__tagline">{tagline}</span>
  <span class="tile__count">{count} article{count > 1 ? 's' : ''} <span aria-hidden="true">→</span></span>
</a>

<style>
  .tile {
    position: relative; display: flex; flex-direction: column; gap: 0.5rem;
    min-height: 19rem; padding: 1.5rem; border-radius: var(--radius); overflow: hidden; isolation: isolate;
    background: var(--surface); border: 1px solid var(--line); text-decoration: none;
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .tile::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--sport);
    clip-path: circle(0% at 100% 0%); transition: clip-path 0.7s var(--ease);
  }
  .tile:hover, .tile:focus-visible { color: #0a0a0b; border-color: var(--sport); }
  .tile:hover::before, .tile:focus-visible::before { clip-path: circle(150% at 100% 0%); }
  .tile__num { font-size: 0.8rem; font-weight: 700; color: var(--sport); font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .tile:hover .tile__num { color: inherit; }
  .tile__emoji {
    position: absolute; right: -0.6rem; top: -0.4rem; font-size: 7.5rem; line-height: 1;
    transform: rotate(14deg); opacity: 0.9; transition: transform 0.7s var(--ease);
  }
  .tile:hover .tile__emoji { transform: rotate(-8deg) scale(1.15); }
  .tile { container-type: inline-size; }
  .tile__name { margin-top: auto; font-size: min(3.6rem, 19cqi); }
  .tile__tagline { font-size: 0.95rem; opacity: 0.75; max-width: 26ch; }
  .tile__count {
    display: inline-flex; gap: 0.4rem; margin-top: 0.5rem; font-weight: 700; font-size: 0.8rem;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile::before, .tile__emoji { transition: none; }
  }
</style>
