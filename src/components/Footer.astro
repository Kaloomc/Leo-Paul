---
import { SITE_TITLE, CONTACT, SOCIALS } from '../consts';
const year = new Date().getFullYear();
const socials = SOCIALS.filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">{SITE_TITLE}</p>
      <p class="muted"><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
    </div>

    {socials.length > 0 && (
      <ul class="site-footer__links" aria-label="Réseaux sociaux">
        {socials.map((s) => (
          <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    )}

    <ul class="site-footer__links" aria-label="Liens utiles">
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/rss.xml">Flux RSS</a></li>
    </ul>
  </div>
  <div class="container">
    <p class="site-footer__copy muted">© {year} {SITE_TITLE}. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem; padding: 2.5rem 0 1.5rem;
    border-top: 1px solid var(--c-border); background: var(--c-surface);
    font-size: 0.95rem;
  }
  .site-footer__inner {
    display: grid; gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .site-footer__inner { grid-template-columns: 2fr 1fr 1fr; }
  }
  .site-footer__brand { font-family: var(--font-head); font-size: 1.2rem; font-weight: 700; margin: 0 0 0.25rem; }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .site-footer__links a { color: var(--c-text); }
  .site-footer__links a:hover { color: var(--c-accent); }
  .site-footer__copy { margin: 2rem 0 0; font-size: 0.85rem; }
</style>
