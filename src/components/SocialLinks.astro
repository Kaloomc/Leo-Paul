---
// Icônes Instagram / TikTok vers les comptes SportFlash (voir SOCIALS dans src/consts.ts)
import { SOCIALS } from '../consts';
interface Props { class?: string; size?: 'sm' | 'lg' }
const { class: cls, size = 'sm' } = Astro.props;
const socials = SOCIALS.filter((s) => s.url);
---

{socials.length > 0 && (
  <ul class:list={['socials', `socials--${size}`, cls]}>
    {socials.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (nouvel onglet)`} title={s.label}>
          {s.icon === 'instagram' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.3" />
              <circle cx="17.6" cy="6.4" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .socials { list-style: none; display: flex; gap: 0.5rem; margin: 0; padding: 0; }
  .socials a {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1px solid var(--line-strong); color: var(--text);
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s, transform 0.3s var(--ease);
  }
  .socials a:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); transform: translateY(-2px) rotate(-6deg); }
  .socials svg { width: 1.15rem; height: 1.15rem; }
  .socials--lg a { width: 3.4rem; height: 3.4rem; }
  .socials--lg svg { width: 1.5rem; height: 1.5rem; }
</style>
